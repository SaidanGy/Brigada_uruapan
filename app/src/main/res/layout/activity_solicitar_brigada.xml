<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Solicitar Brigada"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Selecciona el tipo de apoyo e ingresa tus datos"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Tipo de Unidad / Emergencia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Tipo de unidad / emergencia"
            android:textColor="#3B82F6"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTipoUnidad"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/search_background"
            android:paddingHorizontal="12dp"
            android:spinnerMode="dropdown" />

        <!-- Datos del Solicitante -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Datos de la persona"
            android:textColor="#3B82F6"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombreSolicitante"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/search_background"
            android:hint="Nombre completo"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@android:color/white"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etTelefonoSolicitante"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/search_background"
            android:hint="Teléfono de contacto"
            android:inputType="phone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@android:color/white"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <!-- Datos del Destino -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Dirección de destino"
            android:textColor="#3B82F6"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDireccionDestino"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/search_background"
            android:hint="Calle, número y colonia"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@android:color/white"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etReferencias"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/search_background"
            android:gravity="top"
            android:hint="Referencias (ej. Entre qué calles está...)"
            android:padding="16dp"
            android:textColor="@android:color/white"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <!-- Botón Enviar Solicitud -->
        <Button
            android:id="@+id/btnConfirmarSolicitud"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#2563EB"
            android:text="Enviar Solicitud a la Brigada"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>